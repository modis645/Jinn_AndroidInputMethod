<?xml version="1.0" encoding="utf-8"?>
<!--
  语音转为文字页：从设置页「语音转为文字」按钮进入。
  原设置页的四块语音配置（总开关 / 授权麦克风 / NAS 地址与识别选项）整体搬到这里，行为不变：
  总开关关掉时，授权麦克风卡与服务端卡整块隐藏；关闭状态下保存不校验 host / port。

  保存入口在页面顶部（与设置页同款主按钮）：总开关 / 地址 / 端口 / 语言 / 提示词按它落盘；
  三个勾选框与默认键盘样式是改动即写（原设置页语义），文案照实说（见 VoiceSettingsActivity.TEXT_DESC）。
  新文案全部由 VoiceSettingsActivity 的 TEXT_* 常量下发（strings.xml 默认不改动），
  故本文件的新控件一律不写 android:text；复用既有 @string/settings_* 是允许的。
  「在线语音服务」列表由代码生成（VoiceProviders 目录 + container_providers），
  行是**本卡内的纯行**（行间 1dp 分隔线），不要再逐行套一层卡。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PageRoot"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/PageTitle"
            android:id="@+id/text_voice_title"
            android:layout_height="wrap_content" />

        <Button
            style="@style/PageCloseButton"
            android:id="@+id/btn_voice_close" />
    </LinearLayout>

    <!-- 保存并重启：置顶，写 Prefs 后重启输入法进程（与设置页同一套 ImeRestart）。
         只有「要按保存才写」的项（总开关 / 地址 / 端口 / 语言 / 提示词）靠它落盘；
         三个勾选框与默认键盘样式是改动即写，文案已如实说明（TEXT_DESC）。 -->
    <Button
        style="@style/SettingsButtonPrimary"
        android:id="@+id/btn_voice_save" />

    <TextView
        style="@style/CardHint"
        android:id="@+id/text_voice_save_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 语音输入总开关：默认关闭；关闭时语音完全沉寂（不建实例、长按空格无效），
                 下面两张卡都随它显隐。开关变更需重启输入法进程才生效。 -->
            <LinearLayout
                style="@style/SettingsCard"
                android:id="@+id/card_voice_master">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_voice_master_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/switch_voice_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp" />
                </LinearLayout>

                <TextView
                    style="@style/CardHint"
                    android:id="@+id/text_voice_input_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_voice_input_desc" />
            </LinearLayout>

            <LinearLayout
                style="@style/SettingsCard"
                android:id="@+id/card_local_asr"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/CardHint"
                    android:id="@+id/text_local_asr_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/SettingsLabel"
                    android:id="@+id/text_local_asr_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/progress_local_asr"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/SettingsButton"
                        android:id="@+id/btn_local_asr_download"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1" />

                    <Button
                        style="@style/SettingsButton"
                        android:id="@+id/btn_local_asr_delete"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- 模型导入的兜底入口（2026-11-15）：直连下载失败时，用户可以自己在电脑上
                     下好 model.int8.onnx / tokens.txt（可选 silero_vad.onnx），拷到手机再从这里导入。 -->
                <Button
                    style="@style/SettingsButton"
                    android:id="@+id/btn_local_asr_import"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp" />

                <!-- 下载日志尾部直接显示（2026-11-15）：出问题时用户只要截一张图就能定位，
                     不再需要复制粘贴。只在有日志时出现。 -->
                <TextView
                    android:id="@+id/text_local_asr_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#12000000"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textSize="10sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 授权麦克风：状态 + 单个授权按钮（随总开关整体隐藏） -->
            <LinearLayout
                style="@style/SettingsCard"
                android:id="@+id/card_mic_permission">

                <TextView
                    android:id="@+id/text_mic_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/settings_grant_mic"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    style="@style/SettingsButton"
                    android:id="@+id/btn_grant"
                    android:layout_width="match_parent"
                    android:text="@string/settings_grant_mic" />
            </LinearLayout>

            <!-- 识别选项：语言 + 默认键盘样式 / 提示词 / 末尾处理。
     自建服务端的地址 / 端口 / 固定 三个字段 2026-11-15 已从布局删除（在线语音整套下线），
     Kotlin 侧对应控件改为代码内 stub，见 VoiceSettingsActivity 的 bindingsStub 注释。 -->
            <LinearLayout
                style="@style/SettingsCard"
                android:id="@+id/card_voice_server">


                <!-- 语言 + 默认键盘样式：同行，各占一半 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsLabel"
                            android:text="@string/settings_language" />

                        <com.jinn.inputmethod.UserAwareSpinner
                            style="@style/SettingsField"
                            android:id="@+id/spinner_language"
                            android:layout_width="match_parent"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsLabel"
                            android:text="@string/settings_default_mode" />

                        <com.jinn.inputmethod.UserAwareSpinner
                            style="@style/SettingsField"
                            android:id="@+id/spinner_default_mode"
                            android:layout_width="match_parent"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 识别选项：两个勾选框一行（勾选即落盘） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/check_strip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_strip_punc"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/check_composing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_composing"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 本机离线识别（sherpa-onnx + SenseVoice 快速整句）：模型不随包，按需下载。
                 选中「本机离线」时只显示这张卡；文案由 VoiceSettingsActivity 的 TEXT_* 下发。 -->

            <!-- 语音测试：一次自包含的 3 秒识别，**不依赖 IME 是否正在输入**（自己新建客户端与采集器）。
                 识别正文直接落进 edit_voice_test，结论落 text_voice_test_result —— 用户能在同一个位置
                 看出到底有没有效果。总开关关着也照跑（诊断手段），结论里会注明。
                 文案全部由 VoiceSettingsActivity 的 TEXT_* 下发（strings.xml 不动）。 -->
            <TextView
                style="@style/SectionTitle"
                android:id="@+id/label_voice_test"
                android:layout_height="wrap_content" />

            <LinearLayout
                style="@style/SettingsCard"
                android:id="@+id/card_voice_test">

                <EditText
                    style="@style/SettingsFieldMultiline"
                    android:id="@+id/edit_voice_test"
                    android:layout_width="match_parent"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:minHeight="64dp"
                    android:saveEnabled="false" />

                <Button
                    style="@style/SettingsButton"
                    android:id="@+id/btn_voice_test"
                    android:layout_width="match_parent" />

                <TextView
                    style="@style/CardHint"
                    android:id="@+id/text_voice_test_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
