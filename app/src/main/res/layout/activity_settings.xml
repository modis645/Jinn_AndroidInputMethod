<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（极光紧凑风格）：配置服务端并引导启用输入法。
  能同排的控件一律同排；删掉冗余分组标题，减少卡片数量；
  深蓝极光渐变背景 + 大圆角卡片，视觉更圆润。

  布局顺序（自上而下，2026-09-25 定；2026-10-26 按本文件控件 id 逐行核对重写）：
    标题 → 保存配置并立即重启生效 → 输入法测试（点这里唤起键盘）→ 检查软件更新 / 打开下载页面 →
    启用本输入法 / 改默认输入法 → 符号分组顺序 / 符号的自定义 →
    补充短语词库 / 键盘外观 → 增加模糊拼音 / 加更多生僻字 →
    敲击音效反馈 / 剪贴板自定义 → 图库快贴 / 空格左右按钮 →
    生成用户词库 / 存储占用统计 → 绑定悬浮键盘 / 语音转为文字（同一行）→ 拼音输入方案（单下拉）→
    用户词频学习 / 追加候选词语 → 自动唤起键盘 / 只使用繁体字 →
    在线翻译 →
    导出配置文件 / 导入配置文件 → 导出诊断数据（单按钮）→ 使用说明纯文本
    ⚠ 候选词的行数 / 键盘内显韵母 / 双拼候选全音 / 界面明暗切换（含定时两个时刻）/ 主题与皮肤
    都已迁入「键盘外观」页（activity_key_appearance.xml），剪贴板容量在「剪贴板自定义」页 ——
    本页没有这些控件，别再按旧版清单往这份顺序里补回它们。
  -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PageRoot"
    xmlns:tools="http://schemas.android.com/tools"
    android:overScrollMode="never"
    tools:ignore="TooManyViews">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            style="@style/PageHeroTitle"
            android:text="@string/settings_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:id="@+id/text_settings_subtitle"
            android:text="@string/settings_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 保存并重启：置顶，保存永久配置后重启输入法进程 -->
        <Button
            style="@style/SettingsButtonPrimary"
            android:id="@+id/btn_save"
            android:layout_marginBottom="0dp"
            android:text="@string/settings_save" />

        <TextView
            android:id="@+id/text_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 输入法测试：点这里唤起键盘打字；同时也是「能收图片的宿主」—— 声明 image/* 后键盘的「图库」键
             在这里出现，收到的图直接插进框里（见 ReceivingEditText） -->
        <LinearLayout
            style="@style/SettingsCard">

            <com.jinn.inputmethod.ReceivingEditText
                style="@style/SettingsField"
                android:id="@+id/edit_ime_test"
                android:layout_width="match_parent"
                android:hint="@string/settings_ime_test_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"/>
        </LinearLayout>

        <!-- 检查更新：**已隐藏**（定制版不走官方更新通道，避免远端包覆盖本地改动）。
             控件 id 保留在原位，代码里 findViewById 仍能起，只是整行不显示。 -->
        <LinearLayout
            style="@style/SettingsCardRow"
            android:visibility="gone">

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_check_update"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/settings_check_update" />

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_update_download"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/update_download_page" />
        </LinearLayout>

        <!-- 输入法控制：启用 / 切换。与语音无关，不受语音开关影响 -->
        <LinearLayout
            style="@style/SettingsCardRow">

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_enable"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/settings_enable_ime" />

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_pick"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/settings_pick_ime" />
        </LinearLayout>

        <!-- 符号布局入口：分组顺序 + 收藏编辑，同一张卡片内并排 -->
        <LinearLayout
            style="@style/SettingsCardRow">

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_symbol_order"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/symbol_order_title" />

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_edit_favorites"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/favorite_entry_title" />
        </LinearLayout>

        <!-- 词库补充 / 键盘外观：两个入口按钮并排，各自打开独立页面设置 -->
        <LinearLayout
            style="@style/SettingsCardRow">

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_dict_expand"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/dict_entry_button" />

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_key_appearance"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/key_appearance_entry" />
        </LinearLayout>

        <!-- 模糊音容错 / 加更多生僻字：两个入口按钮并排（文案在代码里下发，strings.xml 默认不改动） -->
        <LinearLayout
            style="@style/SettingsCardRow">

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_fuzzy_pinyin"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp" />

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_rare_chars"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- 剪贴板自定义：独占一行的独立全屏页（2026-11-16 起「敲击音效反馈」入口已删） -->
        <LinearLayout
            style="@style/SettingsCardRow">

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_clipboard_customize"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- 图库快贴：目录绑定 / 清除绑定 / 自动返回 / 缩略图布局都收在子页面里。
             2026-11-16 起同行右侧的「空格左右按钮」入口已删；卡片行容器仍保留（圆角底板与
             边距都由 SettingsCardRow 提供，裸放 button 会与上下邻居长得不一样）。 -->
        <LinearLayout
            style="@style/SettingsCardRow"
            android:baselineAligned="false">

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_gallery_settings"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- 生成用户词库 / 存储占用统计（2026-10-18）：两个入口同行，紧跟「图库快贴 / 空格左右按钮」下一行；
             按钮文案由代码下发。 -->
        <LinearLayout
            style="@style/SettingsCard"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    style="@style/SettingsButton"
                    android:id="@+id/btn_user_dict"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minWidth="0dp" />

                <Button
                    style="@style/SettingsButton"
                    android:id="@+id/btn_storage_usage"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 悬浮键盘 / 语音转为文字：两个入口按钮同行，各占一半（用户第 2 条：
             两个按钮放同一行、不要小字描述）。按钮文案由代码下发（TEXT_FLOATING_ENTRY / TEXT_VOICE_ENTRY），
             strings.xml 默认不改动。 -->
        <LinearLayout
            style="@style/SettingsCardRow"
            android:baselineAligned="false">

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_floating_keyboard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp" />

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_voice_settings"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minWidth="0dp" />
        </LinearLayout>


        <!-- 用户词频学习 / 追加候选词语：两个开关并排（各带说明小字）
             （「加更多生僻字」2026-09-27 起改为入口按钮，与「增加模糊拼音」同行，页内是两档开关） -->
        <LinearLayout
            style="@style/SettingsCardRow"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Switch
                    android:id="@+id/switch_user_learning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/switch_user_learning"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/switch_user_learning_desc"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <Switch
                    android:id="@+id/switch_predict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/switch_predict"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/switch_predict_desc"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 自动唤起键盘 / 只使用繁体字：两个开关并排（各带说明小字）。
             「只使用繁体字」2026-09-27 起由勾选框改为胶囊开关，与「自动唤起键盘」同行（文案在代码里下发） -->
        <LinearLayout
            style="@style/SettingsCardRow"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Switch
                    android:id="@+id/switch_auto_show_keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/switch_auto_show_keyboard"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/switch_auto_show_keyboard_desc"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <Switch
                    android:id="@+id/switch_use_traditional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/CardHint"
                    android:id="@+id/text_use_traditional_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 语音入口已与「绑定悬浮键盘」合并到同一行的卡片里（见上方）。
             四块语音配置（总开关 / 授权麦克风 / NAS 地址与识别选项）已于 2026-11-01 整体迁入
             VoiceSettingsActivity（布局 activity_voice_settings.xml），本页不再保留任何语音控件 ——
             别再照旧版清单把它们补回来。 -->

        <!-- 在线翻译（BYOK）卡片已整体下线：幻影版不做联网翻译，开关与入口一起删除。
             键盘功能面板里的「翻译」键也不再出现（见功能面板的键集合）。 -->

        <!-- 配置备份：导出 / 导入（跨设备迁移）。
             两个按钮的文本由代码下发：strings.xml 默认不改动，布局里留空避免硬编码文案进入资源 -->
        <LinearLayout
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    style="@style/SettingsButton"
                    android:id="@+id/btn_config_export"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minWidth="0dp" />

                <Button
                    style="@style/SettingsButton"
                    android:id="@+id/btn_config_import"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp" />
            </LinearLayout>

            <TextView
                style="@style/CardHint"
                android:id="@+id/text_config_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                />
        </LinearLayout>

        <!-- 导出诊断数据（单按钮，2026-09-25 定）：把日志目录打包，经系统文件选择器
             存到用户自选位置。原「发给作者」分享按钮及其分享通道 / FileProvider 已移除。 -->
        <LinearLayout
            style="@style/SettingsCard">

            <Button
                style="@style/SettingsButton"
                android:id="@+id/btn_export_diag"
                android:layout_width="match_parent"
                android:minWidth="0dp"
                android:text="@string/settings_export_diag" />

            <TextView
                style="@style/CardHint"
                android:id="@+id/text_diag_dir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="middle"/>
        </LinearLayout>

        <!-- 存储占用统计的入口已上移到「图库快贴 / 空格左右按钮」下一行（与「生成用户词库」同行），
             此处不再保留空卡片。 -->

        <!-- 使用说明纯文本（最底部）：六行文案由 SettingsActivity.TEXT_USAGE 下发，
             布局里不写 android:text（values/strings.xml 默认禁改）。 -->
        <TextView
            android:id="@+id/text_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
